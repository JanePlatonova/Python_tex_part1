s=input("Введіть пору року")
if s=="зима":
    print("грудень")
    print("січень")
    print("лютий")
elif s=="весна":
    print("березень")
    print("квітень")
    print("травень")
elif s=="літо":
    print("червень")
    print("липень")
    print("серпень")
else:
    print("вересень")
    print("жовтень ")
    print("листопад")
print ("До побачення")
